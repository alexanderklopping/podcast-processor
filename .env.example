# Preferred local setup: store project secrets in 1Password.
# Missing local keys are resolved from 1Password item `podcast-processor` in vault `Private`
# when the `op` CLI is available. Field names should match the env var names below.
# Optional overrides:
# MEDIAVERWERKER_1PASSWORD_VAULT=Private
# MEDIAVERWERKER_1PASSWORD_ITEM=podcast-processor
# MEDIAVERWERKER_DISABLE_1PASSWORD=true

# Required: API keys
GROQ_API_KEY=gsk_...                    # For transcription (default, ~89% cheaper than OpenAI)
OPENAI_API_KEY=sk-...

# Optional: Use OpenAI Whisper instead of Groq for transcription
# TRANSCRIPTION_PROVIDER=openai         # Default: "groq"
# OPENAI_MODEL_BULK=gpt-5-nano
# OPENAI_MODEL_STRUCTURED=gpt-5.4-nano
# OPENAI_MODEL_POLISH=gpt-5.6-luna
# OPENAI_MODEL_EDITORIAL=gpt-5.6-terra
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# OPENAI_TRANSCRIPTION_MODEL=whisper-1    # Only used when TRANSCRIPTION_PROVIDER=openai

# Optional: GitHub token for pushing feeds to GitHub Pages
# GITHUB_TOKEN=ghp_...
# FEEDS_GITHUB_TOKEN=ghp_...    # Alternative name (used in GitHub Actions)

# Optional: yt-dlp configuration for YouTube/video downloads
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=cookies.txt
# YTDLP_IMPERSONATE=chrome
# YTDLP_REMOTE_COMPONENTS=

# Required for recurring Instagram profile feeds. Export only instagram.com
# cookies in Netscape cookies.txt format, then base64-encode the file.
# INSTAGRAM_COOKIES_B64=

# Optional: Cloud mode (set automatically by GitHub Actions workflows)
# IS_CLOUD=true
